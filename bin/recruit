#!/bin/sh
# recruit — hire an agent into its own herdr pane.
#
#   recruit <role> [task ...]                       hire into the role's default checkout
#   recruit <role> --worktree <branch> [task ...]   hire into a fresh git worktree
#   recruit <role> --worktree <branch> --repo <dir> [task ...]
#                                                   ... of a named repository
#   recruit --roles                                 list available agents
#   recruit -h | --help                             this text
#
# Roles are native Claude Code agent definitions: either a file in ~/.claude/agents/
# or an agent shipped by an installed plugin. Their frontmatter owns the tools, model
# and description; this script only places them in a herdr pane. A role from a plugin
# is written <plugin>:<role>, and a bare name is accepted whenever it is unambiguous.
#
#   <project>/.roster   optional "<role> <path-relative-to-project>" per line
#
# Each hire gets its own tab named <role>-<n>, so any number of agents coexist and
# stay visible in the herdr sidebar. Two writers on one checkout is not allowed —
# use --worktree for the second one.
#
# Every hire — with or without --worktree — lands in a tab of the project workspace.
# See the worktree section below for why the git checkout is made by git itself.

set -eu

AGENTS_DIR="${CLAUDE_AGENTS_DIR:-$HOME/.claude/agents}"
AGENT_KIND="${RECRUIT_AGENT:-claude}"
WORKTREE_DIR="${RECRUIT_WORKTREE_DIR:-$HOME/.herdr/worktrees}"

die() { echo "recruit: $*" >&2; exit 1; }
# -h / --help prints this header: the protocols tell the orchestrator to run --help before
# quoting a flag, so the header has to be reachable as help and not only as a comment.
usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }

TAB=$(printf '\t')

# --- where role definitions live -------------------------------------------------
# Two sources feed one list. A local definition is a file in $AGENTS_DIR, and Claude
# Code knows it by its bare basename. A plugin definition lives in the directory that
# `claude plugin list --json` reports for every enabled plugin, and Claude Code lists
# it under the namespaced name <plugin>:<role>. Asking the CLI beats globbing the
# plugin cache by hand: the cache also holds disabled plugins and stale versions.
# Every line printed here is "<namespace>:<role><TAB><path>", where the namespace
# `local` stands for $AGENTS_DIR.
all_roles() {
    for f in "$AGENTS_DIR"/*.md; do
        [ -f "$f" ] || continue
        printf 'local:%s\t%s\n' "$(basename "$f" .md)" "$f"
    done
    command -v claude >/dev/null 2>&1 || return 0
    python3 -c "
import glob, json, os, subprocess

def cli(*args):
    try:
        out = subprocess.run([\"claude\", *args], capture_output=True, text=True, timeout=30)
        return json.loads(out.stdout)
    except Exception:
        return None

plugins = cli(\"plugin\", \"list\", \"--json\") or []
markets = {}
for m in cli(\"plugin\", \"marketplace\", \"list\", \"--json\") or []:
    if m.get(\"name\"):
        markets[m[\"name\"]] = m.get(\"installLocation\")

# A directory-source marketplace is served live from its working copy, while the copy
# under ~/.claude/plugins/cache can be older than it — the cache was once seen
# missing an agents/ directory the working copy already had. So resolve the plugin
# directory through the marketplace manifest first and keep installPath as the fallback.
def live_dir(plugin, marketplace, fallback):
    root = markets.get(marketplace)
    if root:
        try:
            with open(os.path.join(root, \".claude-plugin\", \"marketplace.json\")) as fh:
                for entry in json.load(fh).get(\"plugins\", []):
                    if entry.get(\"name\") != plugin:
                        continue
                    src = entry.get(\"source\")
                    if isinstance(src, dict):
                        src = src.get(\"path\") or src.get(\"source\")
                    if isinstance(src, str):
                        return os.path.normpath(os.path.join(root, src))
        except Exception:
            pass
    return fallback

for p in plugins:
    if not p.get(\"enabled\"):
        continue
    plugin, _, marketplace = str(p.get(\"id\") or \"\").partition(\"@\")
    if not plugin:
        continue
    path = live_dir(plugin, marketplace, p.get(\"installPath\") or \"\")
    if not path:
        continue
    for f in sorted(glob.glob(os.path.join(path, \"agents\", \"*.md\"))):
        print(\"%s:%s\\t%s\" % (plugin, os.path.basename(f)[:-3], f))
" 2>/dev/null || true
}

case "${1:-}" in
    -h | --help) usage; exit 0 ;;
    --roles) ;;
    -*) die "unknown option $1 (see: recruit --help)" ;;
esac
if [ "${1:-}" = "--roles" ]; then
    all_roles | while IFS="$TAB" read -r qualified path; do
        case "$qualified" in
            local:*) shown=${qualified#local:} ;;
            *)       shown=$qualified ;;
        esac
        printf '%-28s %s\n' "$shown" "$(sed -n 's/^description: //p' "$path" | cut -c1-72)"
    done
    exit 0
fi

role="${1:-}"
[ -n "$role" ] || die "usage: recruit <role> [--worktree <branch>] [--repo <dir>] [task ...]"
shift

worktree=""
repo_opt=""
while :; do
    case "${1:-}" in
        --worktree)
            shift
            worktree="${1:-}"
            [ -n "$worktree" ] || die "--worktree needs a branch name"
            shift
            ;;
        --repo)
            shift
            repo_opt="${1:-}"
            [ -n "$repo_opt" ] || die "--repo needs a directory"
            shift
            ;;
        *)
            break
            ;;
    esac
done
task="$*"

[ -n "$worktree" ] || [ -z "$repo_opt" ] || die "--repo only makes sense together with --worktree"

# --- resolving the name that was typed -------------------------------------------
# Both spellings are accepted. A qualified name (`my-plugin:back`, or `local:back` for a
# file in $AGENTS_DIR) names exactly one definition and always works. A bare `back` is
# expanded when exactly one definition answers to it, and on a collision recruit prints
# the candidates instead of guessing. Demanding the prefix always was the alternative,
# and it was rejected: it taxes every command and every `.roster` line in every project
# to forestall a collision that may never happen, whereas here only the collision pays.
# The refusal is not redundant with Claude Code, which does guess: with two plugins
# defining `probe` it picked one of them silently.
resolve_role() {
    all_roles | awk -F"$TAB" -v want="$1" '
        {
            colon = index($1, ":")
            ns = substr($1, 1, colon - 1)
            role = substr($1, colon + 1)
            if ($1 == want || role == want) print ns "\t" role "\t" $2
        }
    '
}

matches=$(resolve_role "$role")
[ -n "$matches" ] || die "no role $role (see: recruit --roles)"
if [ "$(printf '%s\n' "$matches" | wc -l)" -gt 1 ]; then
    {
        echo "recruit: $role is defined in more than one place — name one of:"
        printf '%s\n' "$matches" | awk -F"$TAB" '{ printf "  %s:%s\n", $1, $2 }'
    } >&2
    exit 1
fi

role_ns=$(printf '%s\n' "$matches" | cut -f1)
role_short=$(printf '%s\n' "$matches" | cut -f2)
if [ "$role_ns" = "local" ]; then
    agent_name="$role_short"
else
    agent_name="$role_ns:$role_short"
fi

command -v herdr >/dev/null 2>&1 || die "herdr not on PATH"
herdr status server >/dev/null 2>&1 || die "herdr server is not running — start it with 'herdr'"

# --- locate the project root: nearest ancestor holding a .roster, else $PWD ------
project_root=$(
    dir=$PWD
    while [ "$dir" != "/" ]; do
        [ -f "$dir/.roster" ] && { echo "$dir"; exit 0; }
        dir=$(dirname "$dir")
    done
    echo "$PWD"
)
project_label=$(basename "$project_root")

# --- where this role works -----------------------------------------------------
role_cwd="$project_root"
if [ -f "$project_root/.roster" ]; then
    # Either spelling is a valid key, so a `.roster` written before the roles moved
    # into a plugin keeps working unchanged.
    rel=$(awk -v r="$agent_name" '$1==r {print $2; exit}' "$project_root/.roster")
    [ -n "$rel" ] || rel=$(awk -v r="$role_short" '$1==r {print $2; exit}' "$project_root/.roster")
    [ -n "$rel" ] && role_cwd="$project_root/$rel"
fi
[ -d "$role_cwd" ] || die "role directory does not exist: $role_cwd"
role_cwd=$(cd "$role_cwd" && pwd)  # normalise "project/." into "project"

# --- which repository a --worktree hire branches from --------------------------
# `.roster` maps a role to a directory, and that directory is not always a git
# checkout: when `.roster` points `reviewer .` at a directory holding several
# repositories and being none of them itself, every `recruit reviewer --worktree` there
# used to die with `not_git_worktree`. Order of resolution: an explicit --repo wins;
# otherwise the role's own directory if it is a checkout; otherwise the single
# repository directly under the project root. Several candidates are never guessed
# between — the hire stops and asks for --repo.
resolve_repo() {
    if [ -n "$repo_opt" ]; then
        case "$repo_opt" in
            /*) candidate="$repo_opt" ;;
            *)  candidate="$project_root/$repo_opt" ;;
        esac
        [ -d "$candidate" ] || die "--repo: no such directory: $candidate"
        top=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null || true)
        [ -n "$top" ] || die "--repo: $candidate is not a git repository"
        echo "$top"
        return 0
    fi

    top=$(git -C "$role_cwd" rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$top" ]; then
        echo "$top"
        return 0
    fi

    found=""
    count=0
    for d in "$project_root"/*/; do
        [ -e "${d}.git" ] || continue
        count=$((count + 1))
        found="${d%/}"
        list="${list:-}${list:+, }$(basename "$found")"
    done
    [ "$count" -eq 1 ] || die "role directory $role_cwd is not a git checkout and $project_root holds $count repositories (${list:-none}) — name one: recruit $role --worktree $worktree --repo <dir>"
    echo "$found"
}

# --- read one field out of a herdr JSON reply ----------------------------------
field() {
    python3 -c '
import json, sys
data = json.load(sys.stdin)
if "error" in data:
    sys.exit("herdr error: %s" % data["error"])
node = data["result"]
for key in sys.argv[1:]:
    node = node[key]
print(node)
' "$@"
}

# --- next free name for this role ----------------------------------------------
# Recomputed on every start attempt: two recruits can run concurrently (e.g. two
# await-mr watchers firing in the same window) and would otherwise both claim -1.
next_name() {
    herdr agent list | python3 -c '
import json, sys
role = sys.argv[1]
agents = json.load(sys.stdin)["result"]["agents"]
used = []
for a in agents:
    name = a.get("name") or ""
    if name.startswith(role + "-"):
        tail = name[len(role) + 1:]
        if tail.isdigit():
            used.append(int(tail))
print("%s-%d" % (role, max(used) + 1 if used else 1))
' "$role_short"
}
name=$(next_name)

# --- find or create the project workspace --------------------------------------
ws=$(herdr workspace list | python3 -c '
import json, sys
label = sys.argv[1]
for w in json.load(sys.stdin)["result"]["workspaces"]:
    if w.get("label") == label:
        print(w["workspace_id"]); break
' "$project_label")
if [ -z "$ws" ]; then
    ws=$(herdr workspace create --cwd "$project_root" --label "$project_label" --focus | field workspace workspace_id)
    echo "workspace $project_label created ($ws)"
fi

# --- the checkout a --worktree hire works in -----------------------------------
# The checkout is made with plain `git worktree add`, not with `herdr worktree create`,
# and the pane is then an ordinary tab of the project workspace.
#
# Why not `herdr worktree create`: in herdr a worktree IS a workspace. The command always
# opens a new workspace and groups it with the repository's own workspace — "worktree
# create creates a Git worktree checkout, opens it as a workspace, and groups it with the
# parent repo workspace" (CLI reference, identical text in v0.7.5 and v0.9.0). There is no
# flag that puts the pane into an existing workspace: --workspace names the *source*
# repository, and passing it together with --cwd is a syntax error (exit 2, usage printed,
# same on 0.7.5 and on 0.9.0). Measured on 0.9.0 in a throwaway repo: one
# `worktree create --cwd <repo>` produced *two* new workspaces —
# the repo's parent workspace and the worktree's own — and neither was the project one.
# `--path` only chooses where the checkout lands on disk; the pane still got its own
# workspace. So the hire was never in the project workspace, on either version.
#
# `git worktree add` keeps the same layout herdr uses ($RECRUIT_WORKTREE_DIR/<repo>/<branch
# with / replaced by ->), so `herdr worktree list --cwd <repo>` still sees the checkout.
# Cleanup is git's: `git -C <repo> worktree remove <path>` (`herdr worktree remove` takes a
# worktree *workspace* id, and there is none any more).
if [ -n "$worktree" ]; then
    repo=$(resolve_repo) || exit 1
    slug=$(printf '%s' "$worktree" | tr '/' '-')
    wt_path="$WORKTREE_DIR/$(basename "$repo")/$slug"
    [ -e "$wt_path" ] && die "checkout already exists: $wt_path — reuse it, or drop it with 'git -C $repo worktree remove $wt_path'"
    mkdir -p "$(dirname "$wt_path")"
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$worktree"; then
        git -C "$repo" worktree add "$wt_path" "$worktree" >/dev/null \
            || die "git worktree add failed for existing branch $worktree in $repo"
    else
        git -C "$repo" worktree add -b "$worktree" "$wt_path" >/dev/null \
            || die "git worktree add -b $worktree failed in $repo"
    fi
    role_cwd="$wt_path"

    # A fresh checkout carries only tracked files, and on repositories whose .gitignore
    # ignores CLAUDE.md the agent's context is deliberately untracked; .claude/ (settings,
    # skills, healthcheck config) is often not committed either. So a --worktree hire used
    # to start blind. Measured once on a smoke run: an agent hired
    # into such a worktree reported "no CLAUDE.md in the repository root" and worked without
    # the project's instructions. Copy the context over, never overwriting what the checkout
    # already has (a repo that tracks its CLAUDE.md keeps the committed one).
    copied=""
    for ctx in CLAUDE.md .claude .mcp.json; do
        if [ -e "$repo/$ctx" ] && [ ! -e "$wt_path/$ctx" ]; then
            cp -R "$repo/$ctx" "$wt_path/$ctx"
            copied="$copied $ctx"
        fi
    done

    echo "worktree $worktree checked out at $wt_path (from $repo)"
    if [ -n "$copied" ]; then
        echo "context copied into the checkout:$copied"
    fi
fi

# --- a pane for the hire: its own tab in the project workspace -----------------
pane=$(herdr tab create --workspace "$ws" --cwd "$role_cwd" --label "$name" --focus | field root_pane pane_id)
[ -n "$pane" ] || die "herdr tab create returned no pane in workspace $ws"

# --- wait until the pane really has a shell ------------------------------------
# `tab create` returns before the shell is up, and `agent start` then fails with
# agent_pane_busy. Keystrokes queue on the pty, so we echo a marker
# and wait for it. The marker must be *assembled by the shell*: the tty driver
# echoes typed characters before the shell even starts, so waiting for text that
# also appears in the command line would match that echo and prove nothing.
# The quotes split the marker in the typed line ("rdyNNN""-ok") but the shell
# concatenates them in the output (rdyNNN-ok), so only real output can match.
#
# The timeout is 120s, not 30s: a shell with a heavy profile, with two or three agents
# already running, regularly took longer than thirty seconds to draw its first prompt.
# Every hire of one session died on that, and the pane was healthy each time — the
# probe simply gave up too early. Keystrokes queue on the pty, so waiting longer costs
# nothing when the shell is fast.
# The comment above is wrong on one point, and it cost every hire of that session: text sent
# before the pty exists is **lost**, not queued. Proven on herdr 0.7.5 — a pane that timed
# out on a 120s single wait answered the very same probe in under a second when it was sent
# again a minute later. So the marker has to be **re-sent**, not waited for longer: one lost
# keystroke then costs a step instead of the whole hire.
READY_TIMEOUT="${RECRUIT_READY_TIMEOUT:-120000}"   # total budget
READY_STEP="${RECRUIT_READY_STEP:-8000}"           # per attempt
ready_probe() {
    attempts=$(( READY_TIMEOUT / READY_STEP ))
    [ "$attempts" -lt 1 ] && attempts=1
    i=0
    while [ "$i" -lt "$attempts" ]; do
        i=$((i + 1))
        tag="rdy$$_$1_$i"
        herdr pane send-text "$pane" "echo \"$tag\"\"-ok\"
" >/dev/null 2>&1
        if herdr pane wait-output "$pane" --match "$tag-ok" --timeout "$READY_STEP" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}
ready_probe 0 || die "pane $pane never reached a shell prompt in ${READY_TIMEOUT}ms — look at it with 'herdr pane read $pane'"

# --- launch the agent ---------------------------------------------------------
# `--agent` is native: Claude Code loads the definition, its tool restrictions and
# its model, whether it came from ~/.claude/agents/ or from a plugin. The pane and the
# herdr agent are named after the bare role, so a namespaced role does not put a colon
# into a tab label.
#
# herdr can still report the pane as busy for a moment after the probe command
# exits, so retry. Each retry runs another probe, which both re-confirms the shell
# and gives the server time to settle.
#
# Block for roughly one second by waiting for output that never arrives. A probe
# alone is not enough here: it returns the moment the marker matches, so retrying
# on it burns every attempt within a second and the pane is still settling.
settle() { herdr pane wait-output "$pane" --match "__never_${$}__" --timeout 1200 >/dev/null 2>&1 || true; }

# --- the workspace trust dialog --------------------------------------------------
# A directory Claude Code has never opened on this machine gets a question before the
# TUI: "Is this a project you created or one you trust?", cursor on "No, exit". It is not
# a tool permission — it is whether the folder's own settings and hooks may be loaded at
# all — and there is no flag that pre-accepts it for an interactive session (`claude
# --help`: the dialog is skipped only under -p or a non-TTY stdout).
# While it stands, `agent start` fails readiness, herdr already lists the agent as
# `blocked`, and the ten attempts above used to end in "stayed busy" with the task
# never delivered (seen on a fresh clone in a temporary directory). The lead chose this
# directory — by running recruit in it, or by naming it in .roster — so trusting it is
# their decision already made: answer "Yes", confirm the cursor moved before Enter
# (Enter on "No, exit" quits claude), and go on to deliver the task.
trust_dialog() {  # prints: none | on-no | on-yes | shown
    herdr pane read "$pane" --source recent --lines 60 2>/dev/null | python3 -c '
import re, sys
text = sys.stdin.read()
if "Yes, I trust this folder" not in text and "one you trust" not in text:
    print("none")
elif re.search(r"❯[^\S\n]*Yes, I trust this folder", text):
    print("on-yes")
elif re.search(r"❯[^\S\n]*No, exit", text):
    print("on-no")
else:
    print("shown")
' 2>/dev/null || echo none
}
agent_in_pane() {  # the name herdr registered for our pane, if any
    herdr agent list 2>/dev/null | python3 -c '
import json, sys
for a in json.load(sys.stdin)["result"]["agents"]:
    if a.get("pane_id") == sys.argv[1] and a.get("name"):
        print(a["name"]); break
' "$pane" 2>/dev/null || true
}
answer_trust_dialog() {
    case "$(trust_dialog)" in
        on-yes) ;;
        *) herdr pane send-keys "$pane" Down >/dev/null 2>&1; settle
           [ "$(trust_dialog)" = "on-yes" ] || { herdr pane send-keys "$pane" Up >/dev/null 2>&1; settle; }
           [ "$(trust_dialog)" = "on-yes" ] || return 1 ;;
    esac
    herdr pane send-keys "$pane" Enter >/dev/null 2>&1
    i=0
    while [ "$i" -lt 30 ]; do
        registered=$(agent_in_pane)
        if [ -n "$registered" ]; then
            ready=$(herdr agent get "$registered" 2>/dev/null | python3 -c '
import json, sys
a = json.load(sys.stdin)["result"]["agent"]
print("yes" if a.get("interactive_ready") and a.get("agent_status") != "blocked" else "no")
' 2>/dev/null || echo no)
            if [ "$ready" = "yes" ]; then
                name="$registered"
                [ "$(trust_dialog)" = "none" ] && return 0
            fi
        fi
        sleep 2
        i=$((i + 1))
    done
    return 1
}

attempt=1
until herdr agent start "$name" --kind "$AGENT_KIND" --pane "$pane" --timeout 180000 \
        -- --agent "$agent_name" >/dev/null 2>&1; do
    if [ "$(trust_dialog)" != "none" ]; then
        answer_trust_dialog && { echo "trust dialog answered for $role_cwd"; break; }
        die "pane $pane is standing on Claude Code's trust dialog and recruit could not answer it — answer it by hand: herdr pane send-keys $pane Down; herdr pane send-keys $pane Enter — then deliver the task with: tell ${registered:-$name} '<task>'"
    fi
    attempt=$((attempt + 1))
    [ "$attempt" -gt 10 ] && die "pane $pane stayed busy after 10 attempts — check it with 'herdr pane read $pane'"
    settle
    fresh=$(next_name)
    if [ "$fresh" != "$name" ]; then
        # Somebody else took our number while we were waiting.
        name="$fresh"
        herdr pane rename "$pane" "$name" >/dev/null 2>&1 || true
    fi
done
echo "hired $name  role=$agent_name  cwd=$role_cwd  pane=$pane"

[ -n "$task" ] || exit 0

# `agent start` reports readiness before the TUI has drawn its input box, so the
# first prompt can be swallowed. Send it, then confirm the agent actually moved.
before=$(herdr agent get "$name" | field agent state_change_seq)
herdr agent prompt "$name" "$task" >/dev/null

# The next command is printed, not run: the watcher has to belong to the session that
# hires, or its verdict lands nowhere. Printing it is cheaper than remembering it —
# once three minutes of planning went by between delivery and `await`, and a short
# task would have finished inside that gap with nobody listening.
next_step() {
    echo "next: await $name   # arm it now — run_in_background: true in an interactive session, foreground with --timeout otherwise"
}
i=0
while [ "$i" -lt 15 ]; do
    after=$(herdr agent get "$name" | field agent state_change_seq)
    [ "$after" != "$before" ] && { echo "task delivered to $name"; next_step; exit 0; }
    i=$((i + 1))
done
herdr agent prompt "$name" "$task" >/dev/null
echo "task re-sent to $name (first attempt was swallowed) — check the pane"
next_step
